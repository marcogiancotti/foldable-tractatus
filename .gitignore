# Dependencies & build output
node_modules/
dist/
coverage/

# Environment & local config
# The negation must come AFTER the pattern it exempts: last match wins.
.env*
!.env.example
*.local

# Vercel CLI link + pulled environment (holds the project's env vars)
.vercel/

# Design exports (kept locally, never committed)
docs/*.zip

# OS / editor noise
.DS_Store
Thumbs.db

# Local agent tooling lockfile (points at a private skills repo)
skills-lock.json
