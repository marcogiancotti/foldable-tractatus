# Optional. Endpoint of your own deployment of the backend/ bundle store.
# Unset, the app is fully functional and the "save notes to a link" UI simply
# does not appear. See DEPLOY.md.
VITE_SYNC_ENDPOINT=

# Optional. Self-hosted Plausible analytics — BOTH must be set, or no script is
# loaded and nothing is sent. Cookieless, no personal data, and no
# reader-authored text ever leaves the browser; the full event catalogue and the
# reasoning are in docs/analytics.md.
#   VITE_PLAUSIBLE_DOMAIN=foldabletractatus.example.com
#   VITE_PLAUSIBLE_SRC=https://plausible.example.com/js/script.js
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SRC=

# Optional, and only needed behind a first-party proxy on a non-standard path:
# the script's event endpoint (data-api). See DEPLOY.md § Analytics.
VITE_PLAUSIBLE_API=
